{
  "expo": {
    "name": "Finanças",
    "slug": "painel-monet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#071a3e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.painelmonet.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Utilizamos Face ID / Touch ID para autenticação biométrica opcional na sua conta."
      }
    },
    "android": {
      "package": "com.painelmonet.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071a3e"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o Finanças utilize o Face ID para desbloqueio rápido."
        }
      ]
    ]
  }
}