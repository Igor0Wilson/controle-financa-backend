# ============================================================
# BANCO DE DADOS — Neon (PostgreSQL)
# ============================================================
# Cole aqui a connection string do seu projeto Neon.
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Fallback para desenvolvimento local (ignorado se DATABASE_URL estiver preenchido)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeiro
DB_USER=postgres
DB_PASS=

# ============================================================
# AUTENTICAÇÃO JWT
# ============================================================
# NUNCA copie este valor para produção! Gere um novo com:
# node -e "const c=require('crypto');process.stdout.write(c.randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_FORTE_DE_96_CARACTERES_HEX
JWT_EXPIRES_IN=7d

# ============================================================
# SERVIDOR
# ============================================================
PORT=3000
